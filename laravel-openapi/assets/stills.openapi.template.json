{
  "openapi": "3.0.3",
  "info": {
    "title": "API Stills Template",
    "version": "1.0.0",
    "description": "Reusable OpenAPI template for Apifox import"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/management/proxy/your-prefix/your-path": {
      "get": {
        "tags": ["YourTag"],
        "summary": "接口名称",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {"type": "string"},
            "description": "示例参数"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      },
      "post": {
        "tags": ["YourTag"],
        "summary": "接口名称",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"type": "string", "description": "示例字段"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": {"type": "integer", "example": 0},
          "message": {"type": "string", "example": "success!"},
          "data": {},
          "time": {"type": "integer", "example": 1710000000},
          "module": {"type": "string", "example": "service.core.ys.com"}
        },
        "required": ["code", "message", "data", "time", "module"]
      }
    }
  }
}
